generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("USER") // USER | ADMIN | SUPER_ADMIN
  image     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]
}

model Service {
  id          String   @id @default(cuid())
  title       String
  description String
  price       Float
  image       String?
  category    String   @default("hair") // hair | skin | makeup | nails
  duration    Int      @default(60) // duration in minutes
  featured    Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookings Booking[]
}

model Product {
  id          String   @id @default(cuid())
  title       String
  description String
  price       Float
  image       String?
  category    String   @default("hair") // hair | skin | makeup
  brand       String?
  inStock     Boolean  @default(true)
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Booking {
  id        String   @id @default(cuid())
  userId    String
  serviceId String
  date      String   // YYYY-MM-DD
  time      String   // HH:mm
  status    String   @default("PENDING") // PENDING | CONFIRMED | CANCELLED | COMPLETED
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model GalleryImage {
  id          String   @id @default(cuid())
  title       String
  image       String
  category    String   @default("general") // general | before-after | styling
  beforeImage String?  // for before/after comparisons
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model SiteContent {
  id        String   @id @default(cuid())
  section   String   // hero, about, contact, testimonial, footer, etc.
  key       String   // title, subtitle, description, image, etc.
  value     String   // The actual content value
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([section, key])
}

model PaymentMethod {
  id                String   @id @default(cuid())
  type              String   // bank | esewa | khalti | imepay
  accountHolderName String?  // for bank
  bankName          String?  // for bank
  branchName        String?  // for bank
  accountNumber     String?  // for bank
  fullName          String?  // for esewa, khalti, imepay
  number            String?  // for esewa, khalti, imepay
  qrImage           String?  // QR code image URL for all types
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
