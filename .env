# Neon PostgreSQL Connection String
# Get yours free at: https://neon.tech → Create Project → Copy connection string
# Example: postgresql://username:password@ep-xxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://neondb_owner:npg_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@ep-xxxxxxxxxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

